# =====================================================================
# stripe-payment-service — environment variables
# Copy this file to .env and fill in your values.
# =====================================================================

# ── Stripe ────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# ── Database ──────────────────────────────────────────────────────────
# Option A: single connection string
DATABASE_URL=sqlite:///./webhook_state.db

# Option B: individual fields (takes precedence over DATABASE_URL)
# DATABASE_HOST=localhost
# DATABASE_PORT=5432
# DATABASE_NAME=payment_db
# DATABASE_USER=payment_user
# DATABASE_PASSWORD=your_password

# DB connection pool (PostgreSQL only)
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20
# DB_POOL_TIMEOUT=30

# ── Callback URL ──────────────────────────────────────────────────────
# Your application's endpoint that receives payment event notifications.
# When a Stripe event is processed, this service POSTs the result here.
#
# Payload example:
#   {
#     "event_type": "customer.subscription.created",
#     "stripe_event_id": "evt_xxx",
#     "stripe_customer_id": "cus_xxx",
#     "plan": "pro",
#     "subscription_id": "sub_xxx",
#     "invoice_id": null
#   }
#
# Your app should respond with 2xx. Failures are logged but non-fatal.
CALLBACK_URL=https://your-app.onrender.com/api/payment/callback

# Optional HMAC secret for callback request authentication.
# The service adds X-Webhook-Signature: sha256=<hmac> to callback requests.
# CALLBACK_SECRET=your_hmac_secret

# Callback timeout in seconds
# CALLBACK_TIMEOUT=10

# ── Price ID → Plan mapping ───────────────────────────────────────────
# JSON mapping of Stripe price IDs to plan names.
# Example:
#   PRICE_MAP_JSON={"price_xxx": "standard", "price_yyy": "pro", "price_zzz": "enterprise"}
PRICE_MAP_JSON={}

# ── Security ──────────────────────────────────────────────────────────
# Store full Stripe event payload (false = store subset only, recommended)
STORE_FULL_PAYLOAD=false

# Max request body size in bytes (default: 1MB)
MAX_REQUEST_SIZE=1048576

# Rate limit (requests per minute)
RATE_LIMIT=100/minute

# Allowed source IPs (comma-separated CIDR, empty = allow all)
# ALLOWED_IPS=3.18.12.63,3.130.192.231,13.235.14.237

# ── Logging ───────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=data/log/webhook.log

# ── Retry ─────────────────────────────────────────────────────────────
MAX_RETRIES=3
RETRY_DELAYS=1,5,15

# ── Metrics ───────────────────────────────────────────────────────────
ENABLE_METRICS=true
